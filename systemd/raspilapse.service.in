# Template. Placeholders are substituted by scripts/install.sh.
[Unit]
Description=Raspilapse Continuous Timelapse Service
Documentation=https://github.com/ekstremedia/raspilapse
After=network.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PYTHON@ @PROJECT_DIR@/src/auto_timelapse.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=raspilapse

Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
